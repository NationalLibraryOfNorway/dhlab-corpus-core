# Copy this file to `.env` and adjust. `.env` is git-ignored, so local paths and
# deployment details never end up in the repository.

# Directory containing urns.db, metadata.db and the alto_*.db shards.
DATABASE_DIR=./tests/data/db

# Maximum number of shards queried concurrently.
MAX_WORKERS=8

# URL prefix the API is served under when it sits behind a reverse proxy (e.g. /dhlab). Empty for none.
ROOT_PATH=
